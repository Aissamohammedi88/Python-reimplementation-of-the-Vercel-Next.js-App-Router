```
# ══════════════════════════════════════════════════════════
# SPA Router Engine — .gitignore
# ══════════════════════════════════════════════════════════

# ─── Python ───────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
dist/
*.egg-info/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/
.hypothesis/

# ─── Data & runtime ──────────────────────────────────────
spa_router_data/
*.log
logs/
*.db
*.sqlite
*.sqlite3
snapshots/
*.snapshot.json

# ─── Node (if you add JS later) ──────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.next/
.nuxt/
.vercel/
.output/

# ─── IDE / Editors ───────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-workspace
*.sublime-project

# ─── OS ──────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ─── Secrets & env ───────────────────────────────────────
.env
.env.local
.env.*.local
*.pem
*.key
*.crt
secrets/
credentials.json
config.local.*

# ─── Temp ────────────────────────────────────────────────
tmp/
temp/
*.tmp
*.bak
*.old
*.orig

# ─── Build artifacts ─────────────────────────────────────
*.pyc
*.pyo
*.pyd
.cache/
.gradle/
target/

# ─── Test coverage ───────────────────────────────────────
.coverage
coverage.xml
nosetests.xml
*.cover
*.log

# ─── Backups ─────────────────────────────────────────────
*~
*.backup
*.backup.*
*.swp
```

