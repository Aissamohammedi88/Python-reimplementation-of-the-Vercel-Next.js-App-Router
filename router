# 3. LRU CACHE with TTL
# ════════════════════════════════════════════════════════════════
class RouteCache:
"""Thread-safe LRU with per-entry TTL and versioning."""

def __init__(self, max_size=200, default_ttl=300):
self.max_size = max_size
self.default_ttl = default_ttl
self._cache = OrderedDict()
self._lock = threading.RLock()
self._hits = 0
self._misses = 0
self._evictions = 0
self._stale_hits = 0
self._version = 0

def get(self, key, allow_stale=False):
with self._lock:
if key not in self._cache:
self._misses += 1
return None
value, stale_at, version = self._cache[key]
now = time.time()
if now > stale_at:
if allow_stale:
self._stale_hits += 1
return value
del self._cache[key]
self._misses += 1
return None
self._cache.move_to_end(key)
self._hits += 1
return value

def set(self, key, value, ttl=None):
ttl = ttl if ttl is not None else self.default_ttl
with self._lock:
self._cache[key] = (value, time.time() + ttl, self._version)
self._cache.move_to_end(key)
while len(self._cache) > self.max_size:
self._cache.popitem(last=False)
self._evictions += 1

def invalidate(self, key):
with self._lock:
if key in self._cache:
del self._cache[key]
self._version += 1

def invalidate_all(self):
with self._lock:
self._cache.clear()
self._version += 1

def peek(self, key):
with self._lock:
entry = self._cache.get(key)
if entry is None:
return None
return entry[0]

def keys(self):
with self._lock:
return list(self._cache.keys())

def stats(self):
with self._lock:
total = self._hits + self._misses
rate = (self._hits / total * 100) if total > 0 else 0
return {
"size": len(self._cache),
"max_size": self.max_size,
"hits": self._hits,
"misses": self._misses,
"stale_hits": self._stale_hits,
"evictions": self._evictions,
"hit_rate": round(rate, 2),
"version": self._version,
}


