# 6. URL UTILITIES
# ════════════════════════════════════════════════════════════════
def split_pathname(path):
"""Split /foo/bar/baz into ['foo', 'bar', 'baz']."""
parts = []
buf = ""
for ch in path:
if ch == "/":
if buf:
parts.append(buf)
buf = ""
else:
buf += ch
if buf:
parts.append(buf)
return parts


def is_group_segment(seg):
"""(group) pattern."""
return seg.startswith("(") and seg.endswith(")")


def is_dynamic_segment(seg):
"""[id] pattern."""
return seg.startswith("[") and seg.endswith("]") and not seg.startswith("[[")


def is_catchall_segment(seg):
"""[...slug] pattern."""
return seg.startswith("[...") and seg.endswith("]")


def is_optional_catchall(seg):
"""[[...slug]] pattern."""
return seg.startswith("[[...") and seg.endswith("]]")


def is_intercepting(seg):
"""(..), (.), (...), (..)(..) patterns."""
markers = ["(..)(..)", "(...)", "(..)", "(.)"]
return any(seg.startswith(m) for m in markers)


def parse_dynamic_segment(seg):
"""Return the param name for [id] or [...slug]."""
if is_catchall_segment(seg):
return seg[4:-1]
if is_optional_catchall(seg):
return seg[5:-2]
if is_dynamic_segment(seg):
return seg[1:-1]
return None


def normalize_path(path):
"""Ensure leading slash, remove trailing."""
if not path.startswith("/"):
path = "/" + path
if len(path) > 1 and path.endswith("/"):
path = path[:-1]
return path


