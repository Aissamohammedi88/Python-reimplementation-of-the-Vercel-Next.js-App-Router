# 8. APP ROUTER — main navigation engine
# ════════════════════════════════════════════════════════════════
class Navigation:
"""A single navigation operation."""

_counter = 0
_lock = threading.Lock()

def __init__(self, url, kind="push"):
with Navigation._lock:
Navigation._counter += 1
self.id = "nav_" + str(Navigation._counter)
self.url = url
self.kind = kind # push | replace | traverse | refresh
self.state = NavState.PENDING
self.started_at = time.time()
self.finished_at = None
self.result = None
self.error = None
self.segments_loaded = 0
self.bytes_loaded = 0
self.from_cache = False

def finish(self, result=None):
self.state = NavState.SUCCESS
self.finished_at = time.time()
self.result = result

def fail(self, error):
self.state = NavState.ERROR
self.finished_at = time.time()
self.error = str(error)

def duration(self):
end = self.finished_at or time.time()
return round((end - self.started_at) * 1000, 2)

def to_dict(self):
return {
"id": self.id,
"url": self.url,
"kind": self.kind,
"state": self.state.value,
"duration_ms": self.duration(),
"segments_loaded": self.segments_loaded,
"bytes_loaded": self.bytes_loaded,
"from_cache": self.from_cache,
"error": self.error,
}


class AppRouter:
"""The main router engine."""

def __init__(self, tree=None):
self.tree = tree or RouteTree()
self.cache = RouteCache(max_size=200, default_ttl=300)
self.segment_cache = SegmentCache(max_size=500, default_ttl=600)
self.queue = PrefetchQueue(max_inflight=8)
self.current_url = "/"
self.history = []
self.history_index = -1
self.listeners = []
self.navigation_log = []
self.scroll_positions = {}
self._lock = threading.RLock()
self._worker_thread = None
self._worker_running = False
self._layout_cache = {}
self._stats = {
"navigations": 0,
"prefetches": 0,
"cache_hits": 0,
"cache_misses": 0,
"errors": 0,
}

# ------------------------------------------------------------
# SUBSCRIPTION
# ------------------------------------------------------------
def subscribe(self, callback):
with self._lock:
self.listeners.append(callback)
return lambda: self._unsubscribe(callback)

def _unsubscribe(self, cb):
with self._lock:
if cb in self.listeners:
self.listeners.remove(cb)

def _emit(self, event):
with self._lock:
listeners = list(self.listeners)
for cb in listeners:
try:
cb(event)
except Exception as e:
log("ERR", "listener error: " + str(e))

# ------------------------------------------------------------
# ROUTE RESOLUTION
# ------------------------------------------------------------
def resolve(self, url):
"""Resolve URL to a matched route node."""
parsed = urlparse(url)
path = normalize_path(parsed.path)
node, params = self.tree.match(path)
if node is None:
return None
return {
"url": url,
"path": path,
"params": params,
"node": node,
"query": parse_qs(parsed.query),
}

# ------------------------------------------------------------
# PREFETCH
# ------------------------------------------------------------
def prefetch(self, url, priority=Priority.DEFAULT):
with self._lock:
if self.cache.get(url):
self._stats["cache_hits"] += 1
self._emit({"type": "prefetch_hit", "url": url})
return False
self.queue.push(url, priority)
self._stats["prefetches"] += 1
self._emit({"type": "prefetch_scheduled", "url": url,
"priority": int(priority), "queue_size": self.queue.size()})
self._ensure_worker()
return True

def prefetch_many(self, urls, priority=Priority.DEFAULT):
count = 0
for url in urls:
if self.prefetch(url, priority):
count += 1
return count

def _ensure_worker(self):
with self._lock:
if self._worker_running:
return
self._worker_running = True
self._worker_thread = threading.Thread(target=self._worker_loop, daemon=True)
self._worker_thread.start()

def _worker_loop(self):
idle_ticks = 0
while True:
item = self.queue.pop()
if item is None:
idle_ticks += 1
if idle_ticks > 20 and self.queue.size() == 0:
with self._lock:
self._worker_running = False
return
time.sleep(0.05)
continue
idle_ticks = 0
url, payload = item
try:
data = self._load_route_payload(url)
self.cache.set(url, data)
self._emit({"type": "prefetch_done", "url": url,
"size": len(json.dumps(data, default=str))})
except Exception as e:
self._emit({"type": "prefetch_error", "url": url, "error": str(e)})
finally:
self.queue.done()

# ------------------------------------------------------------
# PAYLOAD LOADING (simulated)
# ------------------------------------------------------------
def _load_route_payload(self, url):
"""Simulate fetching route data."""
resolved = self.resolve(url)
if resolved is None:
return {
"url": url,
"type": "not_found",
"tree": None,
"rendered_at": datetime.now().isoformat(),
}

# Build segment tree
segments = []
node = resolved["node"]
while node and node.segment:
segments.append({
"segment": node.segment,
"kind": node.kind,
"has_layout": node.layout is not None,
"has_loading": node.loading is not None,
"has_page": node.page is not None,
})
node = node.parent
segments.reverse()

# Simulate stream delay
time.sleep(0.02 * max(1, len(segments)))

payload = {
"url": url,
"path": resolved["path"],
"params": resolved["params"],
"query": resolved["query"],
"segments": segments,
"type": "page" if resolved["node"].page else "layout",
"rendered_at": datetime.now().isoformat(),
"payload_id": hashlib.sha256(url.encode()).hexdigest()[:16],
"version": self.cache._version,
}

return payload

# ------------------------------------------------------------
# NAVIGATE
# ------------------------------------------------------------
def navigate(self, url, kind="push", scroll=True):
nav = Navigation(url, kind)
self._stats["navigations"] += 1
self._emit({"type": "navigation_start", **nav.to_dict()})

try:
# Resolve
resolved = self.resolve(url)
if resolved is None:
nav.fail("Route not found: " + url)
self._emit({"type": "navigation_404", "url": url})
self.navigation_log.append(nav.to_dict())
self._stats["errors"] += 1
return nav

# Check cache
cached = self.cache.get(url)
if cached:
nav.from_cache = True
self._stats["cache_hits"] += 1
data = cached
else:
self._stats["cache_misses"] += 1
self.prefetch(url, Priority.URGENT)
data = self._load_route_payload(url)
self.cache.set(url, data)

nav.segments_loaded = len(data.get("segments", []))
nav.bytes_loaded = len(json.dumps(data, default=str))

# Update history
with self._lock:
# Save scroll for current
if self.current_url:
self.scroll_positions[self.current_url] = {
"x": 0, "y": 0, "t": time.time()
}

if kind == "push":
self.history = self.history[:self.history_index + 1]
self.history.append(url)
self.history_index = len(self.history) - 1
elif kind == "replace":
if self.history_index >= 0 and self.history_index < len(self.history):
self.history[self.history_index] = url
else:
self.history.append(url)
self.history_index = len(self.history) - 1
elif kind == "traverse":
# Already handled by back/forward
pass
elif kind == "refresh":
if self.history_index >= 0 and self.history_index < len(self.history):
self.history[self.history_index] = url

self.current_url = url

nav.finish(result=data)

except Exception as e:
nav.fail(str(e))
self._stats["errors"] += 1

self.navigation_log.append(nav.to_dict())
if len(self.navigation_log) > 100:
self.navigation_log = self.navigation_log[-100:]

self._emit({"type": "navigation_end", **nav.to_dict()})
return nav

def back(self):
with self._lock:
if self.history_index > 0:
self.history_index -= 1
target = self.history[self.history_index]
self.current_url = target
return self.navigate(target, kind="traverse", scroll=False)
return None

def forward(self):
with self._lock:
if self.history_index < len(self.history) - 1:
self.history_index += 1
target = self.history[self.history_index]
self.current_url = target
return self.navigate(target, kind="traverse", scroll=False)
return None

def refresh(self):
self.cache.invalidate(self.current_url)
return self.navigate(self.current_url, kind="refresh")

def invalidate(self, url=None):
if url:
self.cache.invalidate(url)
else:
self.cache.invalidate_all()

# ------------------------------------------------------------
# STATUS
# ------------------------------------------------------------
def status(self):
with self._lock:
return {
"current_url": self.current_url,
"history_size": len(self.history),
"history_index": self.history_index,
"history": self.history[-20:],
"cache": self.cache.stats(),
"segment_cache": self.segment_cache.stats(),
"queue": {
"size": self.queue.size(),
"inflight": self.queue.inflight(),
},
"stats": dict(self._stats),
"recent_navigations": self.navigation_log[-10:],
"routes_count": len(list(self.tree.walk())),
}

def dump(self, path=None):
"""Dump full router state to JSON."""
data = {
"status": self.status(),
"tree": self.tree.to_dict(),
"cache_keys": self.cache.keys(),
"timestamp": datetime.now().isoformat(),
}
path = path or (SNAPSHOT_DIR / ("snapshot_" + str(int(time.time())) + ".json"))
path.write_text(json.dumps(data, indent=2, ensure_ascii=False, default=str), encoding="utf-8")
return path


