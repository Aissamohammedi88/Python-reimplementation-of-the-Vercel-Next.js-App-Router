# 7. ROUTE TREE — file-based route structure
# ════════════════════════════════════════════════════════════════
class RouteNode:
"""A node in the route tree."""

__slots__ = ("segment", "kind", "children", "parent", "path",
"layout", "page", "loading", "error", "not_found",
"template", "default", "metadata", "params")

def __init__(self, segment, kind="static", parent=None):
self.segment = segment
self.kind = kind
self.parent = parent
self.children = {}
self.path = parent.path + "/" + segment if parent else "/" + segment
self.layout = None
self.page = None
self.loading = None
self.error = None
self.not_found = None
self.template = None
self.default = None
self.metadata = {}
self.params = {}

def add_child(self, segment, kind="static"):
if segment in self.children:
return self.children[segment]
node = RouteNode(segment, kind, self)
self.children[segment] = node
return node

def to_dict(self):
return {
"segment": self.segment,
"kind": self.kind,
"path": self.path,
"has_layout": self.layout is not None,
"has_page": self.page is not None,
"has_loading": self.loading is not None,
"has_error": self.error is not None,
"has_not_found": self.not_found is not None,
"children": {k: v.to_dict() for k, v in self.children.items()},
}


class RouteTree:
"""The full route tree, built from file structure or declared manually."""

def __init__(self):
self.root = RouteNode("", kind="root")
self.root.path = "/"

def add_route(self, path, kind="page", handler=None):
"""Add a route. path like '/users/[id]/edit'."""
parts = [p for p in path.split("/") if p]
node = self.root
for part in parts:
k = "static"
if is_group_segment(part):
k = "group"
elif is_optional_catchall(part):
k = "optional_catchall"
elif is_catchall_segment(part):
k = "catchall"
elif is_dynamic_segment(part):
k = "dynamic"
elif is_intercepting(part):
k = "intercepting"
node = node.add_child(part, k)
if kind == "page":
node.page = handler or ("page:" + path)
elif kind == "layout":
node.layout = handler or ("layout:" + path)
elif kind == "loading":
node.loading = handler or ("loading:" + path)
elif kind == "error":
node.error = handler or ("error:" + path)
elif kind == "not_found":
node.not_found = handler or ("notfound:" + path)
return node

def match(self, path):
"""Match a URL path against the tree. Returns (node, params) or (None, {})."""
path = normalize_path(path)
parts = split_pathname(path)
params = {}
node = self._match_recursive(self.root, parts, 0, params)
return node, params

def _match_recursive(self, node, parts, idx, params):
if idx >= len(parts):
if node.page is not None or self._has_any_page(node):
return node
return None

segment = parts[idx]

# 1. Static match
if segment in node.children:
child = node.children[segment]
if child.kind in ("static", "group"):
result = self._match_recursive(child, parts, idx + 1, dict(params))
if result:
return result

# 2. Group match (transparent)
for name, child in node.children.items():
if child.kind == "group":
result = self._match_recursive(child, parts, idx, dict(params))
if result:
return result

# 3. Dynamic match
for name, child in node.children.items():
if child.kind == "dynamic":
param_name = parse_dynamic_segment(name)
new_params = dict(params)
new_params[param_name] = segment
result = self._match_recursive(child, parts, idx + 1, new_params)
if result:
return result

# 4. Catch-all match
for name, child in node.children.items():
if child.kind == "catchall":
param_name = parse_dynamic_segment(name)
new_params = dict(params)
new_params[param_name] = parts[idx:]
return child

# 5. Optional catch-all (matches zero or more)
for name, child in node.children.items():
if child.kind == "optional_catchall":
param_name = parse_dynamic_segment(name)
new_params = dict(params)
new_params[param_name] = parts[idx:]
return child

return None

def _has_any_page(self, node):
if node.page is not None:
return True
for child in node.children.values():
if self._has_any_page(child):
return True
return False

def walk(self):
"""Yield (path, node) for all nodes with a page."""
def _walk(node):
if node.page is not None:
yield node.path, node
for child in node.children.values():
yield from _walk(child)
yield from _walk(self.root)

def to_dict(self):
return self.root.to_dict()


