# 2. PREFETCH QUEUE — priority heap
# ════════════════════════════════════════════════════════════════
class PrefetchQueue:
"""Priority queue with max-inflight cap and rescheduling support."""

def __init__(self, max_inflight=8):
self._heap = []
self._counter = 0
self._lock = threading.Lock()
self._inflight = 0
self._max_inflight = max_inflight
self._canceled = set()

def push(self, url, priority=Priority.DEFAULT, payload=None):
with self._lock:
heapq.heappush(self._heap, (-int(priority), self._counter, url, payload))
self._counter += 1

def pop(self):
with self._lock:
if self._inflight >= self._max_inflight:
return None
while self._heap:
_, _, url, payload = heapq.heappop(self._heap)
if url in self._canceled:
self._canceled.discard(url)
continue
self._inflight += 1
return url, payload
return None

def done(self):
with self._lock:
if self._inflight > 0:
self._inflight -= 1

def cancel(self, url):
with self._lock:
self._canceled.add(url)

def size(self):
with self._lock:
return len(self._heap)

def inflight(self):
with self._lock:
return self._inflight


