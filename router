class Handler(http.server.BaseHTTPRequestHandler):
def log_message(self, *args):
pass

def _json(self, data, code=200):
body = json.dumps(data, ensure_ascii=False, default=str).encode("utf-8")
self.send_response(code)
self.send_header("Content-Type", "application/json; charset=utf-8")
self.send_header("Content-Length", str(len(body)))
self.send_header("Access-Control-Allow-Origin", "*")
self.send_header("X-Powered-By", "SpaRouterEngine/1.0")
self.end_headers()
try:
self.wfile.write(body)
except Exception:
pass

def _html(self, content, code=200):
body = content.encode("utf-8")
self.send_response(code)
self.send_header("Content-Type", "text/html; charset=utf-8")
self.send_header("Content-Length", str(len(body)))
self.end_headers()
try:
self.wfile.write(body)
except Exception:
pass

def _read_json(self):
try:
n = int(self.headers.get("Content-Length", 0))
if n == 0:
return {}
return json.loads(self.rfile.read(n).decode("utf-8"))
except Exception:
return {}

def do_GET(self):
p = urlparse(self.path)
path = p.path
qs = parse_qs(p.query)

if path in ("/", "/index.html"):
self._html(PAGE_HTML)
elif path == "/api/status":
self._json(ROUTER.status())
elif path == "/api/tree":
self._json(ROUTER.tree.to_dict())
elif path == "/api/routes":
routes = [{"path": p, "has_page": n.page is not None,
"has_layout": n.layout is not None}
for p, n in ROUTER.tree.walk()]
self._json({"count": len(routes), "routes": routes})
elif path == "/api/navigate":
url = qs.get("url", ["/"])[0]
kind = qs.get("kind", ["push"])[0]
nav = ROUTER.navigate(url, kind)
self._json(nav.to_dict())
elif path == "/api/prefetch":
url = qs.get("url", ["/"])[0]
prio = int(qs.get("priority", ["1"])[0])
ok = ROUTER.prefetch(url, Priority(prio))
self._json({"scheduled": ok, "url": url, "priority": prio})
elif path == "/api/cache":
self._json(ROUTER.cache.stats())
elif path == "/api/segment_cache":
self._json(ROUTER.segment_cache.stats())
elif path == "/api/history":
self._json({"history": ROUTER.history, "index": ROUTER.history_index})
elif path == "/api/back":
nav = ROUTER.back()
self._json(nav.to_dict() if nav else {"error": "no history"})
elif path == "/api/forward":
nav = ROUTER.forward()
self._json(nav.to_dict() if nav else {"error": "no forward"})
elif path == "/api/refresh":
nav = ROUTER.refresh()
self._json(nav.to_dict())
elif path == "/api/dump":
p = ROUTER.dump()
self._json({"saved_to": str(p), "size": p.stat().st_size})
elif path == "/api/resolve":
url = qs.get("url", ["/"])[0]
resolved = ROUTER.resolve(url)
if resolved:
self._json({
"url": resolved["url"],
"path": resolved["path"],
"params": resolved["params"],
"query": resolved["query"],
"has_page": resolved["node"].page is not None,
})
else:
self._json({"error": "not resolved"}, 404)
elif path == "/api/cache_bust":
state = qs.get("state", ["{}"])[0]
segment = qs.get("segment", ["children"])[0]
param = compute_cache_busting_param(state, segment)
self._json({"param": param})
else:
self._json({"error": "not_found", "path": path}, 404)

def do_POST(self):
p = urlparse(self.path)
path = p.path
body = self._read_json()

if path == "/api/navigate":
url = body.get("url", "/")
kind = body.get("kind", "push")
nav = ROUTER.navigate(url, kind)
self._json(nav.to_dict())
elif path == "/api/prefetch":
url = body.get("url", "/")
prio = body.get("priority", 1)
ok = ROUTER.prefetch(url, Priority(prio))
self._json({"scheduled": ok})
elif path == "/api/prefetch_many":
urls = body.get("urls", [])
prio = body.get("priority", 1)
n = ROUTER.prefetch_many(urls, Priority(prio))
self._json({"scheduled": n, "total": len(urls)})
elif path == "/api/invalidate":
url = body.get("url")
ROUTER.invalidate(url)
self._json({"invalidated": url or "all"})
elif path == "/api/dump":
p = ROUTER.dump()
self._json({"saved_to": str(p)})
else:
self._json({"error": "not_found"}, 404)


class Server(socketserver.ThreadingMixIn, http.server.HTTPServer):
daemon_threads = True
allow_reuse_address = True


