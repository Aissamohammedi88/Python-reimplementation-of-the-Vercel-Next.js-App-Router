# 5. CACHE BUSTING
# ════════════════════════════════════════════════════════════════
def compute_cache_busting_param(router_state, segment, next_url=""):
"""Deterministic short hash from route state."""
payload = "|".join([str(router_state), str(segment), str(next_url)])
digest = hashlib.sha256(payload.encode()).digest()[:12]
return base64.urlsafe_b64encode(digest).decode().rstrip("=")


def set_cache_busting_param(url, param):
parsed = urlparse(url)
qs = parse_qs(parsed.query)
if param:
qs["_rsc"] = [param]
else:
qs.pop("_rsc", None)
new_query = urlencode(qs, doseq=True)
return parsed._replace(query=new_query).geturl()


def hash_params(params):
if not params:
return "0"
items = sorted(params.items())
payload = "&".join([str(k) + "=" + str(v) for k, v in items])
return hashlib.sha1(payload.encode()).hexdigest()[:10]


