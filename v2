class Layout:

    """Layout réutilisable avec slot."""



    def __init__(self, name, render_fn):

        self.name = name

        self.render_fn = render_fn



    def render(self, children, ctx=None):

        return self.render_fn(children, ctx or {})





class Page:

    """Page composable."""



    def __init__(self, path, render_fn, layout=None):

        self.path = path

        self.render_fn = render_fn

        self.layout = layout



    def render(self, ctx=None):

        ctx = ctx or {}

        content = self.render_fn(ctx)

        if self.layout:

            return self.layout.render(content, ctx)

        return content





