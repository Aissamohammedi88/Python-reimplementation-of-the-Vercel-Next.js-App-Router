#  HTTP HANDLER

# ═══════════════════════════════════════════════════════════════════════════

class Handler(http.server.BaseHTTPRequestHandler):



    def log_message(self, *a):

        pass



    def _send(self, code, body, ctype="text/html; charset=utf-8", cookies=None):

        if isinstance(body, str):

            body = body.encode("utf-8")

        try:

            self.send_response(code)

            self.send_header("Content-Type", ctype)

            self.send_header("Content-Length", str(len(body)))

            self.send_header("X-Powered-By", f"NexusRouter/{VERSION}")

            self.send_header("X-Cache", "HIT" if False else "MISS")

            if cookies:

                for c in cookies:

                    self.send_header("Set-Cookie", c)

            self.end_headers()

            self.wfile.write(body)

        except Exception:

            pass



    def _redirect(self, url, cookies=None):

        self.send_response(302)

        self.send_header("Location", url)

        if cookies:

            for c in cookies:

                self.send_header("Set-Cookie", c)

        self.end_headers()



    def _build_context(self, path, params=None):

        cookies = parse_cookies(self.headers.get("Cookie", ""))

        token = cookies.get("session")

        session = get_session(token)

        return {

            "path": path,

            "params": params or {},

            "user": session["data"].get("user") if session else None,

            "session": session,

            "method": self.command,

            "headers": dict(self.headers),

        }



    def do_GET(self):

        parsed = urllib.parse.urlparse(self.path)

        path = parsed.path



        # Route spéciale : test 404

        if path == "/test/404":

            ctx = self._build_context(path)

            self._send(404, ROUTER.render_error(404, ctx))

            return



        # Route spéciale : test 500

        if path == "/test/500":

            ctx = self._build_context(path)

            self._send(500, ROUTER.render_error(500, ctx))

            return



        # Vérifier le cache BFCache

        cached = BFCACHE.get(path)

        if cached:

            self._send(200, cached)

            return



        # Trouver la page

        page, params = ROUTER.match(path)



        if not page:

            ctx = self._build_context(path)

            self._send(404, ROUTER.render_error(404, ctx))

            return



        try:

            ctx = self._build_context(path, params)



            # Middlewares

            mw_result = ROUTER.run_middlewares(path, ctx)

            if mw_result:

                self._send(mw_result.get("status", 200), mw_result.get("body", ""))

                return



            # Rendu

            content = page.render(ctx)



            # Stocker en cache

            BFCACHE.set(path, content)



            self._send(200, content)



        except HTTPAccessFallback as e:

            ctx = self._build_context(path)

            self._send(e.status, ROUTER.render_error(e.status, ctx))

        except Exception as e:

            ctx = self._build_context(path)

            ctx["error"] = str(e)

            self._send(500, ROUTER.render_error(500, ctx))



    def do_POST(self):

        parsed = urllib.parse.urlparse(self.path)

        path = parsed.path



        # Lire le body

        try:

            n = int(self.headers.get("Content-Length", 0))

            body = self.rfile.read(n).decode("utf-8") if n else ""

            form = urllib.parse.parse_qs(body)

        except Exception:

            form = {}



        def get(key):

            return form.get(key, [""])[0].strip()



        # Route : login

        if path == "/login":

            username = get("username")

            password = get("password")

            if username and password:

                token = create_session({"user": {"username": username}})

                self._redirect("/", cookies=[f"session={token}; Path=/; HttpOnly; Max-Age=86400"])

            else:

                ctx = self._build_context("/login")

                ctx["error"] = "Champs vides"

                self._send(200, page_login(ctx))



        # Route : register

        elif path == "/register":

            username = get("username")

            password = get("password")

            if len(username) >= 3 and len(password) >= 4:

                token = create_session({"user": {"username": username}})

                self._redirect("/", cookies=[f"session={token}; Path=/; HttpOnly; Max-Age=86400"])

            else:

                ctx = self._build_context("/register")

                ctx["error"] = "Nom (3+) ou mot de passe (4+) trop court"

                self._send(200, page_register(ctx))



        # Route : clear cache

        elif path == "/cache/clear":

            BFCACHE.clear()

            self._redirect("/cache")



        else:

            self._send(404, "Not found")





class Server(socketserver.ThreadingMixIn, http.server.HTTPServer):

    daemon_threads = True

    allow_reuse_address = True





