#  ROUTER

#  Inspiré de App Router de Next.js

#  Permet d'enregistrer des routes avec layout, middleware, cache

# ═══════════════════════════════════════════════════════════════════════════

class Router:

    """Routeur central avec support de layouts et middleware."""



    def __init__(self):

        self.pages = []

        self.middlewares = []

        self.error_handlers = {}



    def add(self, path, render_fn, layout=None, middleware=None):

        """Ajoute une page au router."""

        page = Page(path, render_fn, layout)

        if middleware:

            self.middlewares.append((path, middleware))

        self.pages.append(page)

        return page



    def match(self, request_path):

        """Trouve la page correspondant à un path."""

        # Exact match d'abord

        for page in self.pages:

            if page.path == request_path:

                return page

        # Pattern match ensuite (ex: /user/:id)

        for page in self.pages:

            pattern = re.sub(r":(\w+)", r"(?P<\1>[^/]+)", page.path)

            pattern = "^" + pattern + "$"

            m = re.match(pattern, request_path)

            if m:

                return page, m.groupdict()

        return None, None



    def run_middlewares(self, request_path, ctx):

        """Exécute les middlewares applicables."""

        for pattern, mw in self.middlewares:

            if pattern == request_path or request_path.startswith(pattern.rstrip("/")):

                result = mw(ctx)

                if result:

                    return result

        return None



    def register_error(self, status, render_fn):

        """Enregistre un handler d'erreur."""

        self.error_handlers[status] = render_fn



    def render_error(self, status, ctx=None):

        """Rend une page d'erreur."""

        if status in self.error_handlers:

            return self.error_handlers[status](ctx or {})

        # Fallback par défaut

        defaults = {

            404: "<h1>404 — Page introuvable</h1><p>Cette page n'existe pas.</p>",

            403: "<h1>403 — Accès refusé</h1><p>Vous n'avez pas la permission.</p>",

            401: "<h1>401 — Non authentifié</h1><p>Veuillez vous connecter.</p>",

            500: "<h1>500 — Erreur serveur</h1><p>Quelque chose a mal tourné.</p>",

        }

        return defaults.get(status, "<h1>Erreur</h1>")





ROUTER = Router()





