#  HTTP ACCESS FALLBACK — Codes d'erreur standardisés

#  Inspiré de HTTPAccessFallbackBoundary de Next.js

# ═══════════════════════════════════════════════════════════════════════════

class HTTPAccessFallback(Exception):

    def __init__(self, status):

        self.status = status

        super().__init__(f"HTTP {status}")





class NotFound(HTTPAccessFallback):

    def __init__(self):

        super().__init__(404)





class Forbidden(HTTPAccessFallback):

    def __init__(self):

        super().__init__(403)





class Unauthorized(HTTPAccessFallback):

    def __init__(self):

        super().__init__(401)





