#  BFCACHE — Back-Forward Cache

#  Inspiré de useRouterBFCache de Next.js

#  Cache les arbres de routes visités pour navigation instantanée

# ═══════════════════════════════════════════════════════════════════════════

class BFCache:

    """Cache les render trees pour navigation instantanée."""



    def __init__(self, max_size=20):

        self.cache = OrderedDict()

        self.max_size = max_size

        self.hits = 0

        self.misses = 0



    def get(self, path):

        if path in self.cache:

            # Move to end (LRU)

            self.cache.move_to_end(path)

            self.hits += 1

            return self.cache[path]

        self.misses += 1

        return None



    def set(self, path, content):

        if path in self.cache:

            self.cache.move_to_end(path)

        else:

            self.cache[path] = content

            if len(self.cache) > self.max_size:

                self.cache.popitem(last=False)



    def clear(self):

        self.cache.clear()

        self.hits = 0

        self.misses = 0



    def stats(self):

        total = self.hits + self.misses

        rate = (self.hits / total * 100) if total > 0 else 0

        return {

            "size": len(self.cache),

            "max_size": self.max_size,

            "hits": self.hits,

            "misses": self.misses,

            "hit_rate": round(rate, 1),

        }





BFCACHE = BFCache(max_size=50)





