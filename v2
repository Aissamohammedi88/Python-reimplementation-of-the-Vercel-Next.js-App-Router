#  COMPOSANTS HTML

#  Inspiré de jsx de React

# ═══════════════════════════════════════════════════════════════════════════

def el(tag, attrs=None, children=None):

    """Crée un élément HTML."""

    attrs = attrs or {}

    children = children or []

    if isinstance(children, str):

        children = [children]



    attr_str = ""

    for k, v in attrs.items():

        k = k.replace("_", "-")

        attr_str += f' {k}="{html.escape(str(v))}"'



    inner = "".join(str(c) for c in children)

    return f"<{tag}{attr_str}>{inner}</{tag}>"





def esc(s):

    return html.escape(str(s)) if s else ""





def raw(s):

    """Marque une chaîne comme HTML brut (non échappée)."""

    return f"__RAW__{s}"





def _render_raw(s):

    """Remplace les marqueurs __RAW__ par le contenu brut."""

    if not isinstance(s, str):

        return s

    return re.sub(r"__RAW__(.*?)(?=__RAW__|$)", r"\1", s, flags=re.DOTALL)





