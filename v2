#  SESSIONS & COOKIES

# ═══════════════════════════════════════════════════════════════════════════

SESSIONS = {}





def create_session(data=None):

    token = secrets.token_urlsafe(32)

    SESSIONS[token] = {

        "data": data or {},

        "created": time.time(),

        "expires": time.time() + 86400,  # 24h

    }

    return token





def get_session(token):

    if not token:

        return None

    s = SESSIONS.get(token)

    if not s:

        return None

    if time.time() > s["expires"]:

        del SESSIONS[token]

        return None

    return s





def parse_cookies(header):

    """Parse le header Cookie."""

    cookies = {}

    if not header:

        return cookies

    for part in header.split(";"):

        if "=" in part:

            k, v = part.split("=", 1)

            cookies[k.strip()] = urllib.parse.unquote(v.strip())

    return cookies





