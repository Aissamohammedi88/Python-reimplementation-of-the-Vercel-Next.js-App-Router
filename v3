# CACHE L1 + L2

# ═══════════════════════════════════════════════════════════════════════════



class CacheL1:

    def __init__(self, max_size=CACHE_L1_MAX):

        self.max_size = max_size

        self.data = OrderedDict()

        self.lock = threading.RLock()

        self.hits = 0

        self.misses = 0

        self.evictions = 0



    def get(self, key):

        with self.lock:

            if key in self.data:

                self.data.move_to_end(key)

                self.hits += 1

                return self.data[key]

            self.misses += 1

            return None



    def set(self, key, value):

        with self.lock:

            if key in self.data:

                self.data.move_to_end(key)

            self.data[key] = value

            while len(self.data) > self.max_size:

                self.data.popitem(last=False)

                self.evictions += 1



    def clear(self):

        with self.lock:

            self.data.clear()



    def stats(self):

        with self.lock:

            total = self.hits + self.misses

            return {

                "size": len(self.data),

                "max": self.max_size,

                "hits": self.hits,

                "misses": self.misses,

                "evictions": self.evictions,

                "hit_rate": round(self.hits / total * 100, 1) if total else 0.0,

            }





class CacheL2:

    def __init__(self, path, max_mb=CACHE_L2_MAX_MB, ttl=CACHE_L2_TTL):

        self.path = path

        self.max_mb = max_mb

        self.ttl = ttl

        self.lock = threading.RLock()

        path.mkdir(parents=True, exist_ok=True)

        self.hits = 0

        self.misses = 0



    def _key_path(self, key):

        h = hashlib.sha256(key.encode()).hexdigest()

        return self.path / (h[:2] + "_" + h[2:] + ".cache")



    def get(self, key):

        fp = self._key_path(key)

        if not fp.exists():

            with self.lock:

                self.misses += 1

            return None

        try:

            with open(str(fp), "rb") as f:

                raw = zlib.decompress(f.read())

            meta_end = raw.index(b"\n")

            meta = json.loads(raw[:meta_end].decode())

            if time.time() - meta["ts"] > self.ttl:

                fp.unlink(missing_ok=True)

                with self.lock:

                    self.misses += 1

                return None

            body = raw[meta_end + 1:].decode("utf-8")

            with self.lock:

                self.hits += 1

            return body

        except Exception:

            with self.lock:

                self.misses += 1

            return None



    def set(self, key, value):

        try:

            meta = json.dumps({"ts": time.time(), "key": key[:200]}).encode()

            payload = meta + b"\n" + value.encode("utf-8")

            with open(str(self._key_path(key)), "wb") as f:

                f.write(zlib.compress(payload, level=6))

        except Exception:

            pass



    def clear(self):

        with self.lock:

            for f in self.path.glob("*.cache"):

                try:

                    f.unlink()

                except Exception:

                    pass



    def stats(self):

        files = list(self.path.glob("*.cache"))

        size = sum(f.stat().st_size for f in files)

        total = self.hits + self.misses

        return {

            "files": len(files),

            "size_mb": round(size / 1024 / 1024, 2),

            "max_mb": self.max_mb,

            "hits": self.hits,

            "misses": self.misses,

            "hit_rate": round(self.hits / total * 100, 1) if total else 0.0,

            "ttl": self.ttl,

        }





CACHE_1 = CacheL1()

CACHE_2 = CacheL2(CACHE_DIR)





