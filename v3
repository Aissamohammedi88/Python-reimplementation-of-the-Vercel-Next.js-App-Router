# ROUTER RADIX TREE

# ═══════════════════════════════════════════════════════════════════════════



class RouteNode:

    __slots__ = ("static", "param", "wildcard", "handlers")

    def __init__(self):

        self.static = {}

        self.param = None

        self.wildcard = None

        self.handlers = {}





class RadixRouter:

    def __init__(self):

        self.root = RouteNode()

        self.routes = []

        self.lock = threading.RLock()



    def add(self, path, handler, methods=None, description="", group=""):

        methods = methods or ["GET"]

        segments = [s for s in path.strip("/").split("/") if s]

        with self.lock:

            node = self.root

            param_names = []

            for seg in segments:

                if seg.startswith(":"):

                    name = seg[1:]

                    param_names.append(name)

                    if node.param is None:

                        node.param = (name, RouteNode())

                    node = node.param[1]

                elif seg.startswith("*"):

                    name = seg[1:] or "wildcard"

                    param_names.append(name)

                    if node.wildcard is None:

                        node.wildcard = (name, RouteNode())

                    node = node.wildcard[1]

                else:

                    if seg not in node.static:

                        node.static[seg] = RouteNode()

                    node = node.static[seg]

            for m in methods:

                node.handlers[m] = {

                    "handler": handler,

                    "path": path,

                    "param_names": param_names,

                    "methods": methods,

                    "description": description,

                    "group": group,

                }

            self.routes.append({

                "path": path,

                "methods": methods,

                "handler": handler.__name__ if hasattr(handler, "__name__") else "lambda",

                "description": description,

                "group": group,

            })



    def match(self, path, method="GET"):

        segments = [s for s in path.strip("/").split("/") if s]

        params = {}



        def _walk(node, i):

            if i == len(segments):

                return node.handlers.get(method) or node.handlers.get("*")

            seg = segments[i]

            if seg in node.static:

                r = _walk(node.static[seg], i + 1)

                if r:

                    return r

            if node.param is not None:

                name, child = node.param

                params[name] = urllib.parse.unquote(seg)

                r = _walk(child, i + 1)

                if r:

                    return r

                params.pop(name, None)

            if node.wildcard is not None:

                name, child = node.wildcard

                params[name] = "/".join(segments[i:])

                return child.handlers.get(method) or child.handlers.get("*")

            return None



        m = _walk(self.root, 0)

        if m:

            m = dict(m)

            m["params"] = params

        return m





ROUTER = RadixRouter()





