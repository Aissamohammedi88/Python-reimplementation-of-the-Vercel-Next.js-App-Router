# RATE LIMITER

# ═══════════════════════════════════════════════════════════════════════════



class RateLimiter:

    def __init__(self, max_per_min=RATE_LIMIT_PER_MIN):

        self.max_per_min = max_per_min

        self.buckets = defaultdict(deque)

        self.lock = threading.Lock()



    def check(self, ip):

        now = time.time()

        with self.lock:

            b = self.buckets[ip]

            while b and now - b[0] > 60:

                b.popleft()

            if len(b) >= self.max_per_min:

                return False

            b.append(now)

            return True





