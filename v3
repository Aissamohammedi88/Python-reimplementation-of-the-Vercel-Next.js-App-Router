# VALIDATION

# ═══════════════════════════════════════════════════════════════════════════



def validate_schema(data, schema):

    errors = {}

    out = {}

    for key, rule in schema.items():

        required = rule.get("required", False)

        if key not in data or data[key] == "":

            if required:

                errors[key] = "Champ requis"

            continue

        val = data[key]

        t = rule.get("type", "str")

        try:

            if t == "int":

                val = int(val)

            elif t == "float":

                val = float(val)

            elif t == "str":

                val = str(val).strip()

        except Exception:

            errors[key] = "Type invalide"

            continue

        if "min" in rule:

            if t in ("int", "float"):

                if val < rule["min"]:

                    errors[key] = "Min " + str(rule["min"])

            else:

                if len(str(val)) < rule["min"]:

                    errors[key] = "Min " + str(rule["min"])

        if "max" in rule:

            if t in ("int", "float"):

                if val > rule["max"]:

                    errors[key] = "Max " + str(rule["max"])

        out[key] = val

    if errors:

        raise ValidationError(errors)

    return out





