# ═══════════════════════════════════════════════════════════════════════════



class Session:

    def __init__(self, token, data=None, ttl=SESSION_TTL):

        self.token = token

        self.data = data or {}

        self.created = time.time()

        self.expires = time.time() + ttl

        self.dirty = False



    def is_valid(self):

        return time.time() < self.expires



    def get(self, k, default=None):

        return self.data.get(k, default)



    def set(self, k, v):

        self.data[k] = v

        self.dirty = True





class SessionStore:

    def __init__(self, path, ttl=SESSION_TTL):

        self.path = path

        self.ttl = ttl

        self.cache = {}

        self.lock = threading.RLock()



    def create(self, data=None):

        token = secrets.token_urlsafe(32)

        s = Session(token, data, self.ttl)

        with self.lock:

            self.cache[token] = s

        return token



    def get(self, token):

        if not token:

            return None

        with self.lock:

            s = self.cache.get(token)

        if s and s.is_valid():

            return s

        return None



    def destroy(self, token):

        with self.lock:

            self.cache.pop(token, None)



    def count(self):

        with self.lock:

            return len(self.cache)





SESSIONS = SessionStore(SESSIONS_DIR)





