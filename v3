class Handler(http.server.BaseHTTPRequestHandler):

    server_version = "NexusRouter/" + VERSION

    protocol_version = "HTTP/1.1"



    def log_message(self, *a):

        pass



    def _cookies(self):

        c = {}

        for part in self.headers.get("Cookie", "").split(";"):

            if "=" in part:

                k, v = part.split("=", 1)

                c[k.strip()] = urllib.parse.unquote(v.strip())

        return c



    def _send(self, code, body, ctype="text/html; charset=utf-8", cookies=None, extra=None):

        if isinstance(body, str):

            body = body.encode("utf-8")

        headers_out = {}

        if ENABLE_GZIP and len(body) > 500:

            ae = self.headers.get("Accept-Encoding", "")

            if "gzip" in ae:

                buf = io.BytesIO()

                with gzip.GzipFile(fileobj=buf, mode="wb") as gz:

                    gz.write(body)

                comp = buf.getvalue()

                if len(comp) < len(body):

                    body = comp

                    headers_out["Content-Encoding"] = "gzip"

        if ENABLE_ETAG:

            etag = '"' + hashlib.md5(body).hexdigest()[:16] + '"'

            if self.headers.get("If-None-Match") == etag:

                self.send_response(304)

                self.send_header("ETag", etag)

                self.end_headers()

                return

            headers_out["ETag"] = etag

        try:

            self.send_response(code)

            self.send_header("Content-Type", ctype)

            self.send_header("Content-Length", str(len(body)))

            self.send_header("X-Powered-By", "NexusRouter/" + VERSION)

            for k, v in headers_out.items():

                self.send_header(k, v)

            if extra:

                for k, v in extra.items():

                    self.send_header(k, v)

            if cookies:

                for c in cookies:

                    self.send_header("Set-Cookie", c)

            self.end_headers()

            self.wfile.write(body)

        except (BrokenPipeError, ConnectionResetError):

            pass



    def _json(self, code, obj, extra=None):

        body = json.dumps(obj, indent=2, ensure_ascii=False, default=str)

        self._send(code, body, "application/json; charset=utf-8", extra=extra)



    def _redirect(self, url, cookies=None):

        self.send_response(302)

        self.send_header("Location", url)

        if cookies:

            for c in cookies:

                self.send_header("Set-Cookie", c)

        self.end_headers()



    def _ctx(self, path, params=None, method="GET"):

        return {

            "path": path,

            "params": params or {},

            "method": method,

            "ip": self.client_address[0] if self.client_address else "?",

            "cookies": self._cookies(),

            "headers": dict(self.headers),

            "user": None,

            "session": None,

        }



    def do_GET(self):

        self._handle("GET")



    def do_POST(self):

        path = urllib.parse.urlparse(self.path).path

        try:

            n = int(self.headers.get("Content-Length", 0))

            raw = self.rfile.read(n).decode("utf-8") if n else ""

            ctype = self.headers.get("Content-Type", "")

            if "application/json" in ctype:

                body = json.loads(raw) if raw else {}

                form = {k: [str(v)] for k, v in body.items()}

            else:

                form = urllib.parse.parse_qs(raw)

        except Exception:

            form = {}



        def g(k):

            return form.get(k, [""])[0].strip()



        if path == "/login":

            u, p = g("username"), g("password")

            if not u or not p:

                ctx = self._ctx("/login", method="POST")

                ctx["error"] = "Champs vides"

                return self._send(200, page_login(ctx))

            row = DB.fetchone("SELECT * FROM users WHERE username = ?", (u,))

            if row and verify_password(p, row["password_hash"]):

                DB.execute("UPDATE users SET last_login=? WHERE id=?", (time.time(), row["id"]))

                token = SESSIONS.create({"user": {"id": row["id"], "username": row["username"]}})

                return self._redirect("/", cookies=[

                    "session=" + token + "; Path=/; HttpOnly; Max-Age=" + str(SESSION_TTL)])

            ctx = self._ctx("/login", method="POST")

            ctx["error"] = "Identifiants invalides"

            return self._send(200, page_login(ctx))



        if path == "/register":

            u, p = g("username"), g("password")

            if len(u) < 3 or len(p) < 6:

                ctx = self._ctx("/register", method="POST")

                ctx["error"] = "Nom ≥ 3, mot de passe ≥ 6"

                return self._send(200, page_register(ctx))

            if DB.fetchone("SELECT id FROM users WHERE username = ?", (u,)):

                ctx = self._ctx("/register", method="POST")

                ctx["error"] = "Nom déjà pris"

                return self._send(200, page_register(ctx))

            uid = DB.insert(

                "INSERT INTO users (username, password_hash, created_at) VALUES (?,?,?)",

                (u, hash_password(p), time.time()))

            token = SESSIONS.create({"user": {"id": uid, "username": u}})

            return self._redirect("/", cookies=[

                "session=" + token + "; Path=/; HttpOnly; Max-Age=" + str(SESSION_TTL)])



        if path == "/logout":

            c = self._cookies()

            if "session" in c:

                SESSIONS.destroy(c["session"])

            return self._redirect("/", cookies=["session=; Path=/; Max-Age=0"])



        if path == "/cache/clear":

            CACHE_1.clear()

            CACHE_2.clear()

            return self._redirect("/cache")



        if path == "/metrics/reset":

            METRICS.reset()

            return self._redirect("/metrics")



        if path == "/graphql":

            try:

                body = json.loads(raw) if raw else {}

            except Exception:

                body = {}

            query = body.get("query", "")

            return self._json(200, self._graphql(query))



        if path == "/api/auth/login":

            u, p = g("username"), g("password")

            row = DB.fetchone("SELECT * FROM users WHERE username = ?", (u,))

            if row and verify_password(p, row["password_hash"]):

                token = jwt_encode({"sub": u, "uid": row["id"]})

                return self._json(200, {"ok": True, "token": token, "username": u})

            return self._json(401, {"ok": False, "error": "invalid"})



        self._send(404, "Not Found")



    def _graphql(self, query):

        query = query.strip()

        m = re.match(r"\{\s*(\w+)\s*(?:\((.*?)\))?\s*\}", query)

        if not m:

            return {"errors": [{"message": "Query invalide"}]}

        field = m.group(1)

        if field == "users":

            rows = DB.fetchall("SELECT id, username, email, created_at FROM users LIMIT 50")

            return {"data": {"users": [dict(r) for r in rows]}}

        if field == "stats":

            return {"data": {"stats": {

                "users": DB.fetchone("SELECT COUNT(*) as c FROM users")["c"],

                "visits": DB.fetchone("SELECT COUNT(*) as c FROM visits")["c"],

            }}}

        return {"errors": [{"message": "Field inconnu : " + field}]}



    def _handle(self, method):

        path = urllib.parse.urlparse(self.path).path



        # WebSocket upgrade

        if ENABLE_WS and path == "/ws/echo" and \

                self.headers.get("Upgrade", "").lower() == "websocket":

            return self._ws_handshake()



        # Prometheus

        if path == "/metrics/prometheus":

            return self._send(200, METRICS.prometheus(), "text/plain; version=0.0.4")



        # API

        if path == "/api/status":

            return self._json(200, {

                "version": VERSION,

                "author": AUTEUR,

                "host": HOST,

                "port": PORT,

                "uptime_s": round(time.time() - METRICS.started, 1),

                "routes": len(ROUTER.routes),

                "metrics": METRICS.stats(),

                "cache": {"l1": CACHE_1.stats(), "l2": CACHE_2.stats()},

                "sessions": SESSIONS.count(),

                "ws_clients": WS.count(),

                "sse_clients": SSE.count(),

                "base": str(BASE),

            })

        if path in ("/health", "/api/health"):

            return self._api_health()

        if path in ("/ready", "/api/ready"):

            return self._json(200, {"ready": True})

        if path in ("/live", "/api/live"):

            return self._json(200, {"live": True})

        if path == "/api/routes":

            return self._json(200, {"count": len(ROUTER.routes), "routes": ROUTER.routes})

        if path == "/api/metrics":

            return self._json(200, METRICS.stats())

        if path == "/api/cache":

            return self._json(200, {"l1": CACHE_1.stats(), "l2": CACHE_2.stats()})

        if path == "/api/events":

            return self._json(200, {"events": SSE.events()})

        if path == "/api/events/stream":

            return self._sse_stream()

        if path == "/api/users":

            rows = DB.fetchall("SELECT id, username, email, created_at FROM users")

            return self._json(200, {"count": len(rows), "users": [dict(r) for r in rows]})



        # Match route

        match = ROUTER.match(path, method=method)

        if not match:

            ctx = self._ctx(path, method=method)

            self._send(404, self._error_page(404, ctx))

            METRICS.record(404, 0.0)

            return



        handler = match["handler"]

        params = match.get("params", {})

        t0 = time.time()

        ctx = self._ctx(path, params, method)



        try:

            # Auth session

            token = ctx["cookies"].get("session")

            s = SESSIONS.get(token) if token else None

            if s:

                ctx["session"] = s

                ctx["user"] = s.get("user")



            # Cache

            cache_key = method + ":" + path

            body = None

            if method == "GET":

                body = CACHE_1.get(cache_key)

                if body is None:

                    body = CACHE_2.get(cache_key)

                    if body is not None:

                        CACHE_1.set(cache_key, body)



            if body is None:

                body = handler(ctx)

                if isinstance(body, str) and not body.startswith("<!DOCTYPE"):

                    body = render(body, ctx)

                if method == "GET":

                    CACHE_1.set(cache_key, body)

                    CACHE_2.set(cache_key, body)



            self._send(200, body, extra={

                "X-Response-Time": "{:.1f}ms".format((time.time() - t0) * 1000),

            })

            METRICS.record(200, time.time() - t0)

            SSE.broadcast("page_view", {"path": path})



        except HTTPError as e:

            body = self._error_page(e.status, ctx)

            self._send(e.status, body)

            METRICS.record(e.status, time.time() - t0)

        except Exception as e:

            ctx["error"] = str(e)

            if DEBUG:

                ctx["traceback"] = traceback.format_exc()

            self._send(500, self._error_page(500, ctx))

            METRICS.record(500, time.time() - t0)



    def _api_health(self):

        checks = {}

        try:

            DB.fetchone("SELECT 1")

            checks["database"] = "ok"

        except Exception as e:

            checks["database"] = "error: " + str(e)[:80]

        try:

            fp = BASE / ".h"

            fp.write_text("ok")

            fp.unlink()

            checks["disk"] = "ok"

        except Exception as e:

            checks["disk"] = "error: " + str(e)[:80]

        checks["cache"] = "ok"

        checks["sessions"] = "ok"

        healthy = all(v == "ok" for v in checks.values())

        return self._json(200 if healthy else 503, {

            "healthy": healthy,

            "checks": checks,

            "uptime_s": round(time.time() - METRICS.started, 1),

        })



    def _sse_stream(self):

        q = SSE.register()

        try:

            self.send_response(200)

            self.send_header("Content-Type", "text/event-stream; charset=utf-8")

            self.send_header("Cache-Control", "no-cache")

            self.send_header("Connection", "keep-alive")

            self.end_headers()

            for e in SSE.events()[-10:]:

                self.wfile.write(("data: " + json.dumps(e, ensure_ascii=False) + "\n\n").encode())

            self.wfile.flush()

            last_ka = time.time()

            while True:

                try:

                    evt = q.get(timeout=2.0)

                    self.wfile.write(("data: " + json.dumps(evt, ensure_ascii=False) + "\n\n").encode())

                    self.wfile.flush()

                    last_ka = time.time()

                except queue.Empty:

                    if time.time() - last_ka > 15:

                        try:

                            self.wfile.write(b": ping\n\n")

                            self.wfile.flush()

                        except Exception:

                            break

                        last_ka = time.time()

        except (BrokenPipeError, ConnectionResetError):

            pass

        finally:

            SSE.unregister(q)



    def _ws_handshake(self):

        key = self.headers.get("Sec-WebSocket-Key", "")

        accept = ws_handshake_key(key)

        conn = None

        try:

            self.send_response(101)

            self.send_header("Upgrade", "websocket")

            self.send_header("Connection", "Upgrade")

            self.send_header("Sec-WebSocket-Accept", accept)

            self.end_headers()

            conn = WSConn(self.connection, self.client_address)

            WS.add(conn)

            conn.send("Bienvenue dans le WebSocket NEXUS")

            while True:

                try:

                    raw = self.connection.recv(4096)

                    if not raw:

                        break

                    payload, opcode = ws_decode_frame(raw)

                    if opcode == 0x8:

                        break

                    if payload:

                        msg = payload.decode("utf-8", errors="replace")

                        WS.broadcast("[" + conn.id + "] " + msg)

                except (ConnectionResetError, OSError):

                    break

        except Exception:

            pass

        finally:

            if conn:

                WS.remove(conn)



    def _error_page(self, code, ctx):

        titles = {400: "Requête invalide", 401: "Non authentifié",

                  403: "Accès refusé", 404: "Introuvable",

                  429: "Trop de requêtes", 500: "Erreur serveur"}

        title = titles.get(code, "Erreur")

        extra = ""

        if code == 500 and ctx.get("error"):

            extra = '<pre>' + esc(ctx.get("error")) + '</pre>'

        return render(

            '<div class="card" style="text-align:center;padding:60px 24px">'

            '<h1 style="font-size:72px;color:#f85149">' + str(code) + '</h1>'

            '<p style="font-size:18px;color:#7d8590">' + esc(title) + '</p>'

            '<p style="color:#484f58;font-size:13px;margin-top:16px">'

            'Path : <code>' + esc(ctx.get("path", "?")) + '</code></p>'

            + extra +

            '<a href="/" class="btn" style="margin-top:20px">Retour</a></div>',

            ctx)





