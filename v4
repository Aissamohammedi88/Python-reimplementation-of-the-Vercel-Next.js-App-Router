    print()

    print(C + "=" * 70 + N)

    print(C + "  NEXUS ROUTER — DEMO" + N)

    print(C + "=" * 70 + N)



    log("INFO", "Prefetching 3 routes with different priorities...")

    ROUTER.prefetch("/home", Priority.BACKGROUND)

    ROUTER.prefetch("/dashboard", Priority.INTENT)

    ROUTER.prefetch("/settings", Priority.DEFAULT)



    log("INFO", "Waiting for prefetch worker...")

    time.sleep(1.5)



    log("INFO", "Cache stats: " + json.dumps(ROUTER.cache.stats()))



    log("INFO", "Navigating to /dashboard (should be cache hit)...")

    nav = ROUTER.navigate("/dashboard")

    print("  Navigation: " + json.dumps(nav.to_dict(), indent=2))



    log("INFO", "Navigating to /profile (should be cache miss)...")

    nav = ROUTER.navigate("/profile")

    print("  Navigation: " + json.dumps(nav.to_dict(), indent=2))



    log("INFO", "Going back...")

    ROUTER.back()



    log("INFO", "Final status:")

    print(json.dumps(ROUTER.status(), indent=2, default=str))





