def log(level, msg):

    line = "[" + datetime.now().isoformat() + "] [" + level + "] " + msg

    try:

        with open(LOG, "a", encoding="utf-8") as f:

            f.write(line + "\n")

    except Exception:

        pass

    color = {"OK": G, "WARN": Y, "ERR": R, "INFO": B}.get(level, C)

    print(color + "[" + level + "]" + N + " " + msg)





