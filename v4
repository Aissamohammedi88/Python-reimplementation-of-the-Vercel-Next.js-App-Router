# 1. PRIORITY — like Next.js PrefetchPriority

# ============================================================

class Priority(IntEnum):

    BACKGROUND = 0

    DEFAULT = 1

    INTENT = 2





# ============================================================

# 2. PREFETCH QUEUE — priority heap

# ============================================================

class PrefetchQueue:

    """Priority queue for prefetch tasks. Higher priority = dequeued first."""



    def __init__(self):

        self._heap = []

        self._counter = 0

        self._lock = threading.Lock()

        self._inflight = 0

        self._max_inflight = 8



    def push(self, url, priority=Priority.DEFAULT, task=None):

        with self._lock:

            # Higher priority first, then FIFO

            heapq.heappush(self._heap, (-int(priority), self._counter, url, task))

            self._counter += 1



    def pop(self):

        with self._lock:

            if not self._heap or self._inflight >= self._max_inflight:

                return None

            _, _, url, task = heapq.heappop(self._heap)

            self._inflight += 1

            return url, task



    def done(self):

        with self._lock:

            if self._inflight > 0:

                self._inflight -= 1



    def size(self):

        with self._lock:

            return len(self._heap)





# ============================================================

# 3. CACHE LRU + TTL — like route cache

# ============================================================

class RouteCache:

    """LRU cache with per-entry TTL."""



    def __init__(self, max_size=200, default_ttl=300):

        self.max_size = max_size

        self.default_ttl = default_ttl

        self._cache = OrderedDict()

        self._lock = threading.RLock()

        self._hits = 0

        self._misses = 0

        self._evictions = 0



    def get(self, key):

        with self._lock:

            if key not in self._cache:

                self._misses += 1

                return None

            value, stale_at = self._cache[key]

            if time.time() > stale_at:

                del self._cache[key]

                self._misses += 1

                return None

            self._cache.move_to_end(key)

            self._hits += 1

            return value



    def set(self, key, value, ttl=None):

        ttl = ttl if ttl is not None else self.default_ttl

        with self._lock:

            self._cache[key] = (value, time.time() + ttl)

            self._cache.move_to_end(key)

            while len(self._cache) > self.max_size:

                self._cache.popitem(last=False)

                self._evictions += 1



    def invalidate(self, key):

        with self._lock:

            if key in self._cache:

                del self._cache[key]



    def invalidate_all(self):

        with self._lock:

            self._cache.clear()



    def stats(self):

        with self._lock:

            total = self._hits + self._misses

            rate = (self._hits / total * 100) if total > 0 else 0

            return {

                "size": len(self._cache),

                "max_size": self.max_size,

                "hits": self._hits,

                "misses": self._misses,

                "evictions": self._evictions,

                "hit_rate": round(rate, 2),

            }





# ============================================================

# 4. CACHE BUSTING — SHA-256 based

# ============================================================

def compute_cache_busting_param(router_state, segment, next_url=""):

    """Deterministic short hash from route state."""

    payload = "|".join([str(router_state), str(segment), str(next_url)])

    digest = hashlib.sha256(payload.encode()).digest()[:12]

    import base64

    return base64.urlsafe_b64encode(digest).decode().rstrip("=")





def set_cache_busting_search_param(url, param):

    """Adds or replaces _rsc query param."""

    parsed = urlparse(url)

    qs = parse_qs(parsed.query)

    qs["_rsc"] = [param]

    new_query = urlencode(qs, doseq=True)

    return parsed._replace(query=new_query).geturl()





# ============================================================

# 5. NAVIGATION STATE MACHINE

# ============================================================

class NavState:

    IDLE = "idle"

    PENDING = "pending"

    SUCCESS = "success"

    ERROR = "error"

    MPA = "mpa"





class Navigation:

    """Represents a single navigation."""



    _counter = 0



    def __init__(self, url, kind="push"):

        Navigation._counter += 1

        self.id = "nav_" + str(Navigation._counter)

        self.url = url

        self.kind = kind  # push | replace | traverse | refresh

        self.state = NavState.PENDING

        self.started_at = time.time()

        self.finished_at = None

        self.result = None

        self.error = None



    def finish(self, result=None):

        self.state = NavState.SUCCESS

        self.finished_at = time.time()

        self.result = result



    def fail(self, error):

        self.state = NavState.ERROR

        self.finished_at = time.time()

        self.error = error



    def duration(self):

        end = self.finished_at or time.time()

        return round((end - self.started_at) * 1000, 2)



    def to_dict(self):

        return {

            "id": self.id,

            "url": self.url,

            "kind": self.kind,

            "state": self.state,

            "duration_ms": self.duration(),

            "error": self.error,

        }





# ============================================================

# 6. ROUTER — main engine

# ============================================================

class Router:

    """Client-side router with prefetch + cache + history."""



    def __init__(self):

        self.cache = RouteCache(max_size=200, default_ttl=300)

        self.queue = PrefetchQueue()

        self.history = []

        self.current_url = "/"

        self.listeners = []

        self.navigation_log = []

        self._lock = threading.RLock()

        self._worker_running = False

        self._worker_thread = None



    # --------------------------------------------------------

    # SUBSCRIPTION

    # --------------------------------------------------------

    def subscribe(self, callback):

        """Subscribe to navigation events. callback(event_dict)."""

        with self._lock:

            self.listeners.append(callback)



    def _emit(self, event):

        with self._lock:

            listeners = list(self.listeners)

        for cb in listeners:

            try:

                cb(event)

            except Exception as e:

                log("ERR", "listener error: " + str(e))



    # --------------------------------------------------------

    # PREFETCH

    # --------------------------------------------------------

    def prefetch(self, url, priority=Priority.DEFAULT):

        """Schedule a prefetch."""

        if self.cache.get(url):

            self._emit({"type": "prefetch_cache_hit", "url": url})

            return

        self.queue.push(url, priority)

        self._emit({"type": "prefetch_scheduled", "url": url, "priority": int(priority)})

        self._ensure_worker()



    def _ensure_worker(self):

        with self._lock:

            if self._worker_running:

                return

            self._worker_running = True

            self._worker_thread = threading.Thread(target=self._worker, daemon=True)

            self._worker_thread.start()



    def _worker(self):

        """Background worker — processes prefetch queue."""

        idle_ticks = 0

        while True:

            item = self.queue.pop()

            if item is None:

                idle_ticks += 1

                if idle_ticks > 10 and self.queue.size() == 0:

                    with self._lock:

                        self._worker_running = False

                    return

                time.sleep(0.1)

                continue

            idle_ticks = 0

            url, task = item

            try:

                data = self._fetch(url)

                self.cache.set(url, data)

                self._emit({"type": "prefetch_done", "url": url, "size": len(str(data))})

            except Exception as e:

                self._emit({"type": "prefetch_error", "url": url, "error": str(e)})

            finally:

                self.queue.done()



    # --------------------------------------------------------

    # FETCH (simulated payload)

    # --------------------------------------------------------

    def _fetch(self, url):

        """Simulate fetching a route payload."""

        time.sleep(0.05)  # simulate network

        payload = {

            "url": url,

            "tree": self._build_tree(url),

            "rendered_at": datetime.now().isoformat(),

            "payload_id": hashlib.sha256(url.encode()).hexdigest()[:16],

        }

        return payload



    def _build_tree(self, url):

        """Build a route tree from URL."""

        parts = [p for p in url.split("/") if p]

        tree = {"segment": "/", "children": []}

        current = tree

        for part in parts:

            node = {"segment": part, "children": []}

            current["children"].append(node)

            current = node

        return tree



    # --------------------------------------------------------

    # NAVIGATE

    # --------------------------------------------------------

    def navigate(self, url, kind="push", use_prefetch=True):

        """Navigate to a URL."""

        nav = Navigation(url, kind)

        self._emit({"type": "navigation_start", **nav.to_dict()})



        try:

            # Check cache first

            cached = self.cache.get(url) if use_prefetch else None



            if cached:

                self._emit({"type": "navigation_cache_hit", "url": url})

                data = cached

            else:

                # High priority prefetch for the target

                self.prefetch(url, priority=Priority.INTENT)

                data = self._fetch(url)

                self.cache.set(url, data)



            # Update state

            if kind == "push":

                self.history.append(self.current_url)

            elif kind == "replace" and self.history:

                self.history[-1] = self.current_url



            self.current_url = url

            nav.finish(result=data)



        except Exception as e:

            nav.fail(str(e))



        self.navigation_log.append(nav.to_dict())

        self._emit({"type": "navigation_end", **nav.to_dict()})

        return nav



    def back(self):

        if self.history:

            prev = self.history.pop()

            self.navigate(prev, kind="traverse")

            return prev

        return None



    def refresh(self):

        self.cache.invalidate(self.current_url)

        self.navigate(self.current_url, kind="refresh")



    # --------------------------------------------------------

    # STATUS

    # --------------------------------------------------------

    def status(self):

        return {

            "current_url": self.current_url,

            "history_size": len(self.history),

            "history": self.history[-10:],

            "cache": self.cache.stats(),

            "queue_size": self.queue.size(),

            "navigations_total": len(self.navigation_log),

            "recent_navigations": self.navigation_log[-5:],

        }





