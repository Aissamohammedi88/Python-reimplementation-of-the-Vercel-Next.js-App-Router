def main():

    print()

    print(C + "=" * 70 + N)

    print(C + "  NEXUS ROUTER — Python" + N)

    print(C + "  Priority queue + LRU cache + state machine + HTTP server" + N)

    print(C + "=" * 70 + N)



    # CLI mode: demo

    if len(sys.argv) > 1 and sys.argv[1] == "demo":

        demo()

        return



    # Server mode

    log("INFO", "Starting HTTP server on port " + str(PORT))

    try:

        with Server(("0.0.0.0", PORT), Handler) as httpd:

            log("OK", "Listening: http://127.0.0.1:" + str(PORT) + "/")

            log("INFO", "Endpoints:")

            log("INFO", "  GET  /                  → Dashboard")

            log("INFO", "  GET  /api/status        → Router status")

            log("INFO", "  GET  /api/navigate?url= → Navigate")

            log("INFO", "  GET  /api/prefetch?url= → Prefetch")

            log("INFO", "  GET  /api/cache         → Cache stats")

            log("INFO", "  GET  /api/back          → Go back")

            log("INFO", "  GET  /api/refresh       → Refresh current")

            log("INFO", "  POST /api/navigate      → Navigate (JSON)")

            log("INFO", "  POST /api/prefetch      → Prefetch (JSON)")

            log("INFO", "  POST /api/invalidate    → Invalidate cache")

            print("")

            httpd.serve_forever()

    except KeyboardInterrupt:

        log("INFO", "Stopped.")

    except OSError as e:

        log("ERR", "Port " + str(PORT) + " : " + str(e))





if __name__ == "__main__":

    main()
